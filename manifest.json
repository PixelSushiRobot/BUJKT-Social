{
  "manifest_version": 3,
  "name": "BUJKT Social",
  "version": "1.0.2",
  "description": "Unofficial. Makes Objkt Social smoother: notifications, messages and price-sorted bookmarks in one place.",
  "homepage_url": "https://bujktsocial.psr.fyi",
  "icons": {
    "16": "icons/favicon.png",
    "32": "icons/favicon.png",
    "48": "icons/icon-512.png",
    "128": "icons/icon-512.png"
  },
  "host_permissions": ["https://data.objkt.com/*", "https://api.tzkt.io/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://objkt.com/*"],
      "js": ["nav.js", "rail.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://objkt.com/*"],
      "js": ["frame.js", "notifications.js", "bookmarks.js"],
      "css": ["notifications.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
